# ---- Flask ----
SECRET_KEY=change-me-run-python--c-"import secrets;print(secrets.token_hex(32))"
DATABASE_URL=postgresql+psycopg2://lms:lms@db:5432/lms
COOKIE_SECURE=false          # true when served over HTTPS
ADMIN_EMAILS=you@example.com # comma separated; become administrators on first sign-in

# ---- Google sign-in ----
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com

# ---- Development only ----
DEV_AUTH=false               # true = sign in with any email (never in production)

# ---- Optional AI Coach ----
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-5-5

# ---- M-Pesa (Safaricom Daraja) ----
PAYWALL_ENABLED=true            # false = every lesson open (use while moving existing learners over)
MPESA_ENV=sandbox               # sandbox while testing, production once Safaricom approves go-live
MPESA_SIMULATE=false            # true = fake payments for local development (no Safaricom calls)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379          # sandbox shortcode; use your Paybill / Till store number in production
MPESA_PASSKEY=                  # from the Daraja portal (sandbox) or Safaricom (production)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # CustomerBuyGoodsOnline for a Till
MPESA_PARTY_B=                  # Till number if you use Buy Goods, otherwise leave empty
MPESA_CALLBACK_BASE=https://learn.yourdomain.com   # public https address of this site
MPESA_CALLBACK_SECRET=          # long random string: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- Refunds and workspace ----
REFUND_ENABLED=true             # learners can request refunds; an admin approves every one
REFUND_PARTIAL_DAYS=3           # guide: after starting, partial refund within this many days of the first payment
REFUND_PARTIAL_PERCENT=50       # guide: share refunded in that window (nothing started = 100%)
WORKSPACE_DAYS=30               # how long the workspace pass lasts from the first payment
WORKSPACE_MIN_PERCENT=25        # share of the price that unlocks the workspace
