# ---- Flask ----
SECRET_KEY=change-me-run-python--c-"import secrets;print(secrets.token_hex(32))"
DATABASE_URL=postgresql+psycopg2://lms:lms@db:5432/lms
COOKIE_SECURE=false          # true when served over HTTPS
ADMIN_EMAILS=you@example.com # comma separated; become administrators on first sign-in

# ---- Google sign-in ----
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com

# ---- Development only ----
DEV_AUTH=false               # true = sign in with any email (never in production)

# ---- Optional AI Coach ----
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-5-5

# ---- Mpesa ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/callback

