# Copy to .env, then:  docker compose up --build   ->   http://localhost:8080
SECRET_KEY=            # python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=change-me
GOOGLE_CLIENT_ID=      # see README, "Google sign-in"
ADMIN_EMAILS=          # your email(s), comma separated: you become the trainer/admin
COOKIE_SECURE=false    # set true once the site is served over HTTPS
DEV_AUTH=false         # true only on your laptop: sign in with any email, no Google
ANTHROPIC_API_KEY=     # optional: switches on the AI Coach
COACH_MODEL=claude-sonnet-5-5
